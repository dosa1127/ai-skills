# Normalize text files in repo
* text=auto

# Keep skill/source files LF across platforms
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.sh text eol=lf
*.bash text eol=lf
*.zsh text eol=lf
*.ps1 text eol=lf
*.py text eol=lf
*.js text eol=lf
*.ts text eol=lf

# Windows-native scripts
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files (no EOL normalization)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.svg text eol=lf
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.7z binary
